# Interactive Brokers (IB Gateway must be running with API enabled)
IB_HOST=127.0.0.1
IB_PORT=4002            # 4002 = IB Gateway paper, 4001 = LIVE
IB_CLIENT_ID=17
TRADING_MODE=paper      # "live" requires also changing IB_PORT — deliberate two-field change
MARKET_DATA_TYPE=1      # 1=live, 3=delayed (auto-fallback if no subscription)
ORDER_TIMEOUT_S=120     # paper-sim fills can take minutes without live option data
FILL_GRACE_S=15         # post-cancel window for late execution reports
BLOCK_ENTRIES_ON_DELAYED_DATA=true  # refuse entries when quotes fell back to delayed
MAX_OPTION_SPREAD_PCT=0.08          # entry quote spread must pass both this and cents cap
MAX_OPTION_SPREAD_CENTS=30
MAX_OPTION_QUOTE_AGE_S=5
ENTRY_BUDGET_RESERVE_PCT=0.05       # size market entries from ask plus this reserve
MAX_ENTRY_DRIFT_ATR=0.5             # skip if price already moved favorably away
MAX_ENTRY_DRIFT_MIN_CENTS=10
MAX_EXECUTION_SLIPPAGE_PCT=0.03     # post-fill incident threshold vs ask/bid
MAX_EXECUTION_SLIPPAGE_CENTS=10
MAX_ACCEPTABLE_FILL_LATENCY_S=10
EXECUTION_DIAGNOSTIC_MAX_AGE_DAYS=7
EXECUTION_LIVE_CONFIRMED=false      # live mode also needs recent passing paper diagnostics

# Strategy — Opening-Range Breakout
SYMBOLS=SPY,AAPL,MSFT,NVDA
ORB_WINDOW_MINUTES=15          # opening range = first N minutes after 09:30 ET
ORB_BREAKOUT_BUFFER_PCT=0.0005 # a completed bar must close beyond the range by this fraction
MAX_TRADES_PER_DAY=2
MAX_CONTRACTS=10               # raised, but capped so one fill can't zero the account
MAX_PREMIUM_USD=2000           # raised, but capped
STOP_BUFFER_CENTS=40           # fallback stop when a candidate carries none
NO_NEW_ENTRIES_BEFORE=09:30
NO_NEW_ENTRIES_AFTER=15:30
ATR_WINDOW_BARS=14
PROTECTIVE_STOP=false   # broker-side GTC stop (backstop for the in-loop mental stop);
                        # enable after verifying with `tajator test-order --with-stop`
ORDER_REF_PREFIX=tajator  # provenance tag on every order tajator places
# Per-symbol overrides are limited to the entry-time window, e.g.:
# SYMBOL_STRATEGY_OVERRIDES={"AAPL":{"no_new_entries_after":"14:00"}}

# Stop-distance rule: the opposite-side stop must fall inside this cent band.
# Wide by ORB standards (the stop is the far side of the opening range), but
# still a sanity ceiling.
STOP_MIN_CENTS=5
STOP_MAX_CENTS=400

# Re-entry discipline: a level that stopped us out is dead this long (0 disables)
STOP_COOLDOWN_MINUTES=30

# Runner stop after the first scale-out: breakeven (default — room toward hod/lod)
# or first_target (tighter lock at the scale-out price)
RUNNER_STOP=breakeven

# Conservative backtest-only execution assumptions. Cached historical option
# OHLC does not include bid/ask, so half-spread + slippage are applied adversely
# to both entries and exits and disclosed in each JSON report.
BACKTEST_HALF_SPREAD_PCT=0.01
BACKTEST_SLIPPAGE_CENTS=1.0
BACKTEST_COMMISSION_PER_CONTRACT=0.65
BACKTEST_MIN_COMMISSION_PER_ORDER=1.0

# Telegram trade notifications (optional — leave blank to disable, live runs only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
